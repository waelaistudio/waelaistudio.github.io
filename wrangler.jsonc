{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waelaistudio-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "TIKTOK_CLIENT_SECRET"
    ]
  }
}
