{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waelaistudio-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "TIKTOK_TOKENS",
      "id": "982f8a593c4142fbb4a9a7c5b792dd56"
    }
  ],
  "secrets": {
    "required": [
      "TIKTOK_CLIENT_SECRET"
    ]
  },
  "vars": {
    "TIKTOK_CLIENT_KEY": "sbawrto8glrbd2mt2h",
    "TIKTOK_REDIRECT_URI": "https://waelaistudio-github-io.mohamedenwael3.workers.dev/auth/tiktok/callback"
  }
}
