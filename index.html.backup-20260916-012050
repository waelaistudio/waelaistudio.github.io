<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>WaelAiStudio | AI Content Creation</title>
  <meta name="description" content="WaelAiStudio creates AI-powered visual content, product videos and digital media experiences.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #080808;
      color: #ffffff;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(8, 8, 8, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    nav {
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .logo span {
      color: #8b5cf6;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      font-size: 14px;
      color: #bdbdbd;
    }

    .nav-links a:hover {
      color: #ffffff;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      text-align: center;
      padding: 110px 0 70px;
      background:
        radial-gradient(circle at 50% 35%, rgba(139,92,246,0.20), transparent 35%),
        linear-gradient(180deg, #0d0d0d 0%, #080808 100%);
    }

    .hero-content {
      max-width: 850px;
      margin: auto;
    }

    .badge {
      display: inline-block;
      padding: 8px 16px;
      border: 1px solid rgba(139,92,246,0.5);
      border-radius: 50px;
      color: #c4b5fd;
      font-size: 13px;
      margin-bottom: 25px;
      background: rgba(139,92,246,0.08);
    }

    h1 {
      font-size: clamp(48px, 10vw, 92px);
      line-height: 1;
      margin-bottom: 25px;
      letter-spacing: -3px;
    }

    .gradient {
      background: linear-gradient(90deg, #ffffff, #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: #aaa;
      font-size: clamp(17px, 3vw, 21px);
      max-width: 680px;
      margin: auto;
    }

    .buttons {
      margin-top: 35px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 14px 25px;
      border-radius: 10px;
      font-weight: 700;
      transition: 0.25s;
    }

    .btn-primary {
      background: #ffffff;
      color: #080808;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      background: #ddd;
    }

    .btn-secondary {
      border: 1px solid #333;
      color: #ffffff;
    }

    .btn-secondary:hover {
      border-color: #777;
      background: #151515;
    }

    section {
      padding: 90px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #888;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      padding: 30px;
      border: 1px solid #222;
      border-radius: 18px;
      background: #0e0e0e;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #444;
    }

    .icon {
      font-size: 30px;
      margin-bottom: 20px;
    }

    .card h3 {
      margin-bottom: 10px;
      font-size: 20px;
    }

    .card p {
      color: #888;
      font-size: 15px;
    }

    .showcase {
      background: #0b0b0b;
    }

    .showcase-box {
      border: 1px solid #222;
      border-radius: 24px;
      padding: 45px 25px;
      text-align: center;
      background:
        radial-gradient(circle at center, rgba(139,92,246,0.12), transparent 55%),
        #0e0e0e;
    }

    .showcase-box h3 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .showcase-box p {
      color: #999;
      max-width: 650px;
      margin: auto;
    }

    .contact {
      text-align: center;
    }

    .contact p {
      color: #999;
      margin: 15px auto 30px;
      max-width: 600px;
    }

    footer {
      border-top: 1px solid #222;
      padding: 30px 0;
      text-align: center;
      color: #666;
      font-size: 13px;
    }

    footer a {
      color: #999;
      margin: 0 8px;
    }

    @media (max-width: 750px) {
      .nav-links {
        display: none;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      h1 {
        letter-spacing: -2px;
      }

      section {
        padding: 70px 0;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container">
    <nav>
      <a href="#" class="logo">Wael<span>Ai</span>Studio</a>

      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </div>
</header>

<main>

  <section class="hero">
    <div class="container hero-content">

      <div class="badge">AI • CREATIVE • DIGITAL</div>

      <h1>
        Create Beyond<br>
        <span class="gradient">Imagination.</span>
      </h1>

      <p>
        AI-powered visual content, product videos and digital experiences
        designed for modern brands and creators.
      </p>

      <div class="buttons">
        <a href="#work" class="btn btn-primary">Explore Our Work</a>
        <a href="#contact" class="btn btn-secondary">Let's Connect</a>
      </div>

    </div>
  </section>

  <section id="services">
    <div class="container">

      <div class="section-title">
        <h2>What We Create</h2>
        <p>Creative production powered by AI and modern technology.</p>
      </div>

      <div class="cards">

        <div class="card">
          <div class="icon">🎬</div>
          <h3>AI Video</h3>
          <p>
            Dynamic short-form videos designed for products,
            brands and social media.
          </p>
        </div>

        <div class="card">
          <div class="icon">✨</div>
          <h3>AI Visuals</h3>
          <p>
            High-quality AI-assisted images and creative
            visual concepts.
          </p>
        </div>

        <div class="card">
          <div class="icon">🚀</div>
          <h3>Digital Content</h3>
          <p>
            Creative digital experiences built to help ideas
            stand out online.
          </p>
        </div>

      </div>
    </div>
  </section>

  <section id="work" class="showcase">
    <div class="container">

      <div class="section-title">
        <h2>Selected Work</h2>
        <p>AI-powered product and visual content.</p>
      </div>

      <div class="showcase-box">
        <h3>From Product to Story.</h3>

        <p>
          We transform simple product visuals into engaging
          cinematic content using AI, motion and creative direction.
        </p>
      </div>

    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">

      <div class="section-title">
        <h2>Let's Create.</h2>
        <p>
          Have an idea, product or project?
          Let's turn it into something remarkable.
        </p>
      </div>

      <div class="buttons">
        <a
          href="https://www.instagram.com/waelaistudio/"
          class="btn btn-primary"
          target="_blank">
          Instagram
        </a>
      </div>

    </div>
  </section>

</main>

<footer>
  <div class="container">

    <p>© 2026 WaelAiStudio. All rights reserved.</p>

    <div style="margin-top:10px;">
      <a href="terms.html">Terms of Service</a>
      <a href="privacy.html">Privacy Policy</a>
    </div>

  </div>
</footer>

</body>
</html>
